# Copia questo file in .env e modifica i valori che ti servono.

# Indirizzo e porta su cui pubblicare il servizio.
# 127.0.0.1 = solo da questo computer; 0.0.0.0 = da tutta la rete (il servizio non ha login: vedi README).
CONVERTER_BIND=127.0.0.1
CONVERTER_PORT=8080

# Conversioni contemporanee e lavori tenuti in memoria (in coda + finiti).
MAX_PARALLEL=2
MAX_QUEUE=200
# Ore dopo cui i risultati vengono cancellati.
RETAIN_HOURS=6
# Dimensione massima di un file caricato, in GB.
MAX_UPLOAD_GB=20
# Dimensione massima di ogni file creato durante una conversione, in GB (protegge il disco).
MAX_OUTPUT_GB=50
# Conversioni da disattivare, separate da virgole (es. un codec che non funziona): heic>avif,pdf>epub
DISABLED_CONVERSIONS=

# Risorse massime del container.
CONVERTER_CPUS=4
CONVERTER_MEMORY=4G

# Utente che esegue il servizio dentro il container (proprietario dei file di lavoro).
CONVERTER_UID=1000
CONVERTER_GID=1000
TZ=Europe/Rome
