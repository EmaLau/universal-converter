# Copia questo file in .env e modifica i valori che ti servono.

# Indirizzo e porta su cui pubblicare il servizio.
# 127.0.0.1 = solo da questo computer; 0.0.0.0 = da tutta la rete (la pagina web non ha login: vedi README).
CONVERTER_BIND=127.0.0.1
CONVERTER_PORT=8080

# Conversioni contemporanee e lavori tenuti in memoria (in coda + finiti).
MAX_PARALLEL=2
MAX_QUEUE=200
# Ore dopo cui i risultati vengono cancellati.
RETAIN_HOURS=6
# Dimensione massima di un file caricato, in GB.
MAX_UPLOAD_GB=20
# Dimensione massima di ogni file creato durante una conversione, in GB (protegge il disco).
MAX_OUTPUT_GB=50
# Conversioni da disattivare, separate da virgole (es. un codec che non funziona): heic>avif,pdf>epub
DISABLED_CONVERSIONS=

# Chiavi API (pagina /admin). Senza password l'area admin resta disattivata.
# In alternativa scrivi la password nel file admin-password della cartella dei dati (/work/data).
CONVERTER_ADMIN_PASSWORD=
# Valori iniziali dei due interruttori della pagina /admin (poi contano quelli salvati lì).
# API_REQUIRE_KEY=true: le chiamate all'API fuori dalla pagina web devono avere una chiave.
API_REQUIRE_KEY=false
# CONVERTER_ADMIN_LOGIN=false: la pagina /admin si apre senza password.
CONVERTER_ADMIN_LOGIN=true
# PLICO_URL: indirizzo di Plico per il browser (http://nas:30128, oppure :30128 = stesso host). Vuota = niente scheda.
PLICO_URL=
# WEBHOOK_SECRET: firma dei webhook (X-Converter-Signature). WEBHOOK_HOSTS: host ammessi in callback_url (vuota = tutti).
WEBHOOK_SECRET=
WEBHOOK_HOSTS=
# METRICS=false spegne /metrics (Prometheus).
METRICS=true
# PREVIEWS=false spegne le anteprime dei risultati nella pagina.
PREVIEWS=true
# URL_IMPORT=false spegne la conversione da un indirizzo web. URL_ALLOW_PRIVATE=true ammette anche la rete locale.
URL_IMPORT=true
URL_ALLOW_PRIVATE=false

# Trascrizione di audio e video (facoltativa): indirizzo di un servizio Whisper compatibile con OpenAI,
# es. http://whisper:8000 (speaches, whisper.cpp, LocalAI). Vuoto = niente trascrizioni.
WHISPER_URL=
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_API_KEY=

# OCR automatico delle scansioni prima di PDF -> Word, Excel, testo (lingue di Tesseract installate: ita, eng).
AUTO_OCR=true
OCR_LANG=ita+eng
# Memoria massima dei convertitori in Python (pdf2docx, PyMuPDF...), in GB.
TOOL_MEMORY_GB=3
# I lavori sopravvivono al riavvio (false = un riavvio cancella tutto).
KEEP_JOBS=true
# I propri caratteri (TTF, OTF) vanno nella cartella fonts del volume /work (FONTS_DIR=/work/fonts).

# Risorse massime del container.
CONVERTER_CPUS=4
CONVERTER_MEMORY=4G

# Utente che esegue il servizio dentro il container (proprietario dei file di lavoro).
CONVERTER_UID=1000
CONVERTER_GID=1000
TZ=Europe/Rome
